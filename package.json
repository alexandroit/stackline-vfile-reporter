{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-vfile-reporter/issues"
  },
  "main": "index.js",
  "name": "@stackline/vfile-reporter",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "browser": {
    "./lib/color.js": "./lib/color.browser.js",
    "./lib/platform.js": "./lib/platform.browser.js"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "cross-env FORCE_COLOR=\"true\" node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://github.com/alexandroit/stackline-vfile-reporter#readme",
  "keywords": [
    "vfile",
    "vfile-util",
    "vfile-reporter",
    "util",
    "utility",
    "reporter",
    "virtual",
    "file",
    "formatter",
    "report",
    "format",
    "message",
    "warning",
    "error",
    "stackline",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-vfile-reporter.git"
  },
  "description": "vfile utility to create a report for a file",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
      "name": "Titus Wormer",
      "email": "tituswormer@gmail.com"
    }
  ],
  "dependencies": {
    "vfile": "^5.0.0",
    "vfile-sort": "^3.0.0",
    "string-width": "^5.0.0",
    "vfile-message": "^3.0.0",
    "supports-color": "^9.0.0",
    "vfile-statistics": "^2.0.0",
    "@types/supports-color": "^8.0.0",
    "unist-util-stringify-position": "^3.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm"
    ]
  },
  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "devDependencies": {
    "strip-ansi": "^7.0.0",
    "cross-env": "10.1.0",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "lib/color.browser.d.ts",
    "lib/color.browser.js",
    "lib/color.d.ts",
    "lib/color.js",
    "lib/index.d.ts",
    "lib/index.js",
    "lib/platform.browser.d.ts",
    "lib/platform.browser.js",
    "lib/platform.d.ts",
    "lib/platform.js",
    "license",
    "readme.md",
    "UPSTREAM.md",
    "NOTICE",
    "CHANGELOG.md"
  ]
}
